# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ─── AI Vision (plate + fridge inspection) ──────────────────
# Default provider is Anthropic Claude (vision). OpenAI supported as fallback.
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_VISION_MODEL=claude-opus-4-8
OPENAI_API_KEY=your-openai-key            # optional fallback

# ─── Geo / Maps ─────────────────────────────────────────────
# Used for store geocoding + travel distance. Mapbox or Google.
MAPBOX_TOKEN=your-mapbox-token

# ─── Grocery price providers ────────────────────────────────
# Per-chain scraper/API endpoints (LT retail: Lidl, Maxima, Iki, Rimi).
PRICE_PROVIDER_BASE_URL=https://your-price-aggregator.example.com
PRICE_PROVIDER_API_KEY=your-price-api-key
