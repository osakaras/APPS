# Copy to .env.local and fill in. Only the REQUIRED block is needed to run live.

# ─── REQUIRED · Supabase ────────────────────────────────────
# Project URL + anon key: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── RECOMMENDED · Supabase service role ────────────────────
# Server-only. Lets the AI scanners + manual entry create NEW canonical
# ingredients in the catalog. Without it, scans/edits still work but any
# unrecognized food is stored with a null ingredient_id (won't feed recipe
# matching or the taste graph). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── RECOMMENDED · Anthropic (AI vision) ────────────────────
# Powers the Plate Scanner + Fridge Inspector. Without it, both fall back to
# a deterministic labeled mock so the full flow still runs end to end.
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_VISION_MODEL=claude-opus-4-8   # optional override; this is the default

# ─── NOT YET WIRED (placeholders for future work) ───────────
# Distance currently uses the browser's geolocation + PostGIS/Haversine — no
# Maps key required. Store prices come from the seeded store_products table
# (migration 0004), not a live provider yet. These are here as a roadmap only.
# MAPBOX_TOKEN=
# PRICE_PROVIDER_BASE_URL=
# PRICE_PROVIDER_API_KEY=
